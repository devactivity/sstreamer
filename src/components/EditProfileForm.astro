---
import { t, PLATFORM_LABEL, type Lang } from '../lib/i18n';
import { DAYS, PLATFORMS } from '../lib/constants';
import { getGameIndex, sortGames } from '../lib/games';
import { DEFAULT_DURATION } from '../lib/schedule-encode';
import type { Streamer } from '../lib/schedule';

interface Props {
	lang: Lang;
	entry: Streamer;
}

const { lang, entry } = Astro.props;
const s = t(lang);
const d = entry.data;
const games = sortGames([...(await getGameIndex()).values()]);

const primaryChannel = d.channels.find((c) => c.primary) ?? d.channels[0];

/**
 * Three schedules is the cap. Past that the form stops being a form, and a streamer
 * with four distinct slots is rare enough to be worth a hand edit.
 */
const MAX_SLOTS = 3;

// Duration and title have no visible control, so they ride along hidden. Without that
// a form edit would quietly reset a hand-tuned 180 minute stream back to the default,
// because the submission replaces the whole schedule rather than merging into it.
const slots = Array.from({ length: MAX_SLOTS }, (_, i) => {
	const block = d.schedule.recurring[i];
	return {
		n: i + 1,
		// The first slot keeps the original field names, which are the sheet columns
		// that already exist. Later slots are packed into `streams` client-side.
		suffix: i === 0 ? '' : String(i + 1),
		game: block?.game ?? (i === 0 ? (d.games[0]?.id ?? '') : ''),
		start: block?.start ?? '20:00',
		days: block?.days ?? [],
		duration: block?.duration_min ?? DEFAULT_DURATION,
		title: i === 0 ? (block?.title ?? '') : '',
		visible: i === 0 || Boolean(block),
	};
});
---

<section class="edit" data-edit data-slug={entry.id}>
	<details>
		<summary>{s.editProfile}</summary>

		<form data-edit-form>
			<label class="field">
				<span class="field-label">{s.editKeyLabel}</span>
				<input
					type="text"
					name="edit_key"
					autocomplete="off"
					spellcheck="false"
					placeholder="XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX"
					data-key-input
				/>
				<span class="hint">{s.editKeyHint}</span>
				<span class="hint hint--error" data-key-error hidden>{s.editKeyBad}</span>
			</label>

			<div class="grid">
				<label class="field">
					<span class="field-label">{s.claimPlatformLabel}</span>
					<select name="platform">
						{PLATFORMS.map((p) => (
							<option value={p} selected={p === primaryChannel?.platform}>
								{PLATFORM_LABEL[p] ?? p}
							</option>
						))}
					</select>
				</label>

				<label class="field">
					<span class="field-label">{s.claimHandleLabel}</span>
					<input type="text" name="handle" autocomplete="off" value={primaryChannel?.handle ?? ''} />
				</label>
			</div>

			{/*
			  Not pre-filled from the existing avatar: that is a repo path, not a URL, and
			  showing it back would invite someone to edit it into something unfetchable.
			  Blank means "no request", which is what most submissions are.
			*/}
			<label class="field avatar-field">
				<span class="field-label">{s.avatarUrlLabel}</span>
				<input
					type="url"
					name="avatar_url"
					autocomplete="off"
					spellcheck="false"
					placeholder="https://..."
				/>
				<span class="hint">{s.avatarUrlHint}</span>
			</label>

			{slots.map((slot) => (
				<fieldset class="slot" data-slot hidden={!slot.visible}>
					<legend class="slot-legend">{s.scheduleSlot(slot.n)}</legend>

					<div class="grid">
						<label class="field">
							<span class="field-label">{s.claimGameLabel}</span>
							<select name={`game${slot.suffix}`}>
								<option value="">-</option>
								{games.map((g) => (
									<option value={g.id} selected={g.id === slot.game}>
										{g.data.name}
									</option>
								))}
							</select>
						</label>

						<label class="field">
							<span class="field-label">{s.claimTimeLabel}</span>
							<input type="time" name={`start${slot.suffix}`} value={slot.start} />
						</label>
					</div>

					<fieldset class="days">
						<legend class="field-label">{s.claimDaysLabel}</legend>
						{DAYS.map((day, i) => (
							<label class="day-toggle">
								<input
									type="checkbox"
									name={`days${slot.suffix}`}
									value={day}
									checked={slot.days.includes(day)}
								/>
								<span>{s.dayShort[i]}</span>
							</label>
						))}
					</fieldset>

					<input type="hidden" name={`duration${slot.suffix}`} value={String(slot.duration)} />
					{slot.title && <input type="hidden" name="title" value={slot.title} />}

					{slot.n > 1 && <p class="hint">{s.scheduleGameHint}</p>}
				</fieldset>
			))}

			<div class="actions">
				<button type="submit">{s.editSubmit}</button>
				<button
					type="button"
					class="secondary"
					data-slot-add
					hidden={slots.every((slot) => slot.visible)}
				>
					{s.scheduleAdd}
				</button>
			</div>

			<p class="hint">{s.editLostKey}</p>
		</form>

		<p
			class="pending"
			data-edit-pending
			hidden
			data-msg-preview={s.claimPending}
			data-msg-sent={s.sentEdit}
			data-msg-failed={s.sendFailed}
		>
		</p>
	</details>
</section>

<script>
	import { hashEditKey, isWellFormedEditKey } from '../lib/edit-key';
	import { SubmitNotConfiguredError, submitToForm } from '../lib/submit';
	import { DEFAULT_DURATION, encodeBlocks } from '../lib/schedule-encode';

	const root = document.querySelector<HTMLElement>('[data-edit]');
	const form = root?.querySelector<HTMLFormElement>('[data-edit-form]');

	if (root && form) {
		const keyInput = form.querySelector<HTMLInputElement>('[data-key-input]');
		const keyError = form.querySelector<HTMLElement>('[data-key-error]');
		const pending = root.querySelector<HTMLElement>('[data-edit-pending]');
		const addBtn = form.querySelector<HTMLButtonElement>('[data-slot-add]');
		const slotEls = [...form.querySelectorAll<HTMLElement>('[data-slot]')];

		// Reveals one slot at a time rather than showing three mostly-empty schedules to
		// everyone. Hidden slots submit nothing, because a slot is read from its checked
		// day boxes and a hidden one has none.
		addBtn?.addEventListener('click', () => {
			const next = slotEls.find((el) => el.hidden);
			if (next) next.hidden = false;
			if (!slotEls.some((el) => el.hidden)) addBtn.hidden = true;
		});

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const raw = keyInput?.value.trim() ?? '';

			// Format check only. Whether the key is *correct* is decided by the sync
			// Action against the stored hash - a browser check would be bypassable, so
			// a wrong key here simply routes the submission to manual review instead.
			if (raw && !isWellFormedEditKey(raw)) {
				if (keyError) keyError.hidden = false;
				keyInput?.focus();
				return;
			}
			if (keyError) keyError.hidden = true;

			const keyHash = raw ? await hashEditKey(raw) : '';
			const data = new FormData(form);
			const value = (key: string) => String(data.get(key) ?? '');
			const daysOf = (name: string) =>
				[...form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)].map(
					(el) => el.value,
				);

			// Slots past the first are packed into one field. No days checked means the
			// streamer dropped that schedule, so it is simply not encoded.
			const extras = ['2', '3']
				.map((suffix) => ({
					game: value(`game${suffix}`),
					days: daysOf(`days${suffix}`),
					start: value(`start${suffix}`),
					duration_min: Number(value(`duration${suffix}`)) || DEFAULT_DURATION,
				}))
				.filter((block) => block.days.length > 0);

			const allGames = [value('game'), ...extras.map((b) => b.game)].filter(Boolean);

			let outcome: 'sent' | 'preview' | 'failed';
			try {
				await submitToForm({
					slug: root.dataset.slug,
					edit_key_hash: keyHash,
					platform: value('platform'),
					handle: value('handle'),
					game: value('game'),
					games: [...new Set(allGames)].join('|'),
					start: value('start'),
					days: daysOf('days').join('|'),
					duration_min: value('duration'),
					title: value('title'),
					streams: encodeBlocks(extras),
					avatar_url: value('avatar_url'),
				});
				outcome = 'sent';
			} catch (err) {
				outcome = err instanceof SubmitNotConfiguredError ? 'preview' : 'failed';
			}

			if (pending) {
				pending.textContent =
					outcome === 'sent'
						? (pending.dataset.msgSent ?? '')
						: outcome === 'preview'
							? (pending.dataset.msgPreview ?? '')
							: (pending.dataset.msgFailed ?? '');
				pending.hidden = false;
			}
			if (outcome !== 'failed') form.hidden = true;
		});
	}
</script>

<style>
	.edit {
		margin-top: 2rem;
	}

	details {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 0.7rem 0.9rem;
	}

	summary {
		cursor: pointer;
		font-weight: 600;
		font-size: 0.92rem;
	}

	summary:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	form {
		margin-top: 0.9rem;
	}

	form[hidden] {
		display: none;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.field-label {
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--muted);
	}

	.hint {
		font-size: 0.78rem;
		color: var(--muted);
	}

	.hint--error {
		color: var(--danger);
	}

	.hint[hidden] {
		display: none;
	}

	.avatar-field {
		margin-bottom: 0.9rem;
	}

	input[type='text'],
	input[type='url'],
	input[type='time'],
	select {
		font: inherit;
		font-size: 1rem; /* 16px stops iOS Safari zooming on focus */
		color: var(--text);
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 0.6rem 0.7rem;
		width: 100%;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
		gap: 0.7rem;
		margin: 0.9rem 0;
	}

	.slot {
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 0.2rem 0.9rem 0.6rem;
		margin: 0 0 0.9rem;
		min-width: 0; /* fieldset defaults to min-content, which breaks the grid */
	}

	.slot[hidden] {
		display: none;
	}

	.slot-legend {
		padding: 0 0.4rem;
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--muted);
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.slot .grid {
		margin-top: 0.5rem;
	}

	.days {
		border: 0;
		padding: 0;
		margin: 0 0 0.6rem;
	}

	.days legend {
		padding: 0;
		margin-bottom: 0.4rem;
	}

	.day-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		margin-right: 0.6rem;
		font-size: 0.9rem;
	}

	.actions {
		display: flex;
		gap: 0.5rem;
		margin-bottom: 0.6rem;
	}

	.actions {
		flex-wrap: wrap;
	}

	button {
		font: inherit;
		font-weight: 600;
		cursor: pointer;
		background: var(--accent);
		color: var(--accent-fg);
		border: 1px solid transparent;
		border-radius: var(--radius);
		padding: 0.6rem 1.1rem;
	}

	button.secondary {
		background: transparent;
		color: var(--muted);
		border-color: var(--border);
	}

	button[hidden] {
		display: none;
	}

	.pending {
		margin: 0.6rem 0 0;
		font-size: 0.88rem;
		color: var(--muted);
	}

	.pending[hidden] {
		display: none;
	}
</style>
