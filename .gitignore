# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# service account keys. this repo is public: a committed key is a compromised key.
# Google names its downloads <project>-<keyid>.json, which no sensible pattern
# catches, so ignore every root-level .json and allow back the three we need.
/*.json
!/package.json
!/package-lock.json
!/tsconfig.json

# and anywhere in the tree, for the obvious names
*service-account*.json
*-credentials.json
*-key.json
gcp-*.json

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/
