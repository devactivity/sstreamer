# Copy to .env for local runs. .env is gitignored - keep it that way, this repo is public.
# In CI these come from GitHub secrets instead, and no .env file exists.

# The spreadsheet id, from the sheet URL between /d/ and /edit
SHEET_ID=

# Path to the downloaded service account key file.
# Safer locally than inlining the JSON: the key stays in one file you can delete.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Alternative to the above: the whole key file inline. This is what CI uses.
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional. Defaults to Submissions!A:Z
# SHEET_RANGE=Submissions!A:Z
